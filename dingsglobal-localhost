#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly WORKSPACE_DIR="$(dirname -- "$SCRIPT_DIR")"
readonly COMPOSE_FILE="$SCRIPT_DIR/apps.compose.yaml"
readonly RUNTIME_ROOT="$SCRIPT_DIR/.runtime"
readonly WEB_MAIN="$WORKSPACE_DIR/dingsglobal-web"
readonly API_STAGING="$WORKSPACE_DIR/dingsglobal-api"
readonly CMS_MAIN="$WORKSPACE_DIR/dingsglobal-cms"
readonly TEST_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
readonly TEST_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

fail() {
  printf 'DingsGlobal localhost command failed: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command '$1' is unavailable."
}

usage() {
  cat <<'EOF'
Usage:
  dingsglobal-localhost up [--web PATH] [--api PATH] [--cms PATH] [--all] [--name NAME]
  dingsglobal-localhost status [STACK_ID]
  dingsglobal-localhost logs STACK_ID [SERVICE]
  dingsglobal-localhost down STACK_ID
  dingsglobal-localhost down -all
  dingsglobal-localhost cleanup --path WORKTREE_PATH

The application stack is owned by this repository. PostgreSQL remains shared
through dingsglobal-db and the JavaMifi local database service.
EOF
}

for command_name in curl docker git npm readlink sha256sum ss; do
  require_command "$command_name"
done

canonical_dir() {
  [[ -d "$1" ]] || fail "Directory does not exist: $1"
  readlink -f -- "$1"
}

branch_name() {
  git -C "$1" branch --show-current 2>/dev/null || true
}

matching_worktree() {
  local main="$1"
  local branch="$2"
  local path=""
  local line

  [[ -n "$branch" ]] || return 1
  while IFS= read -r line; do
    case "$line" in
      'worktree '*) path="${line#worktree }" ;;
      "branch refs/heads/$branch")
        printf '%s\n' "$path"
        return 0
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain)
  return 1
}

copy_baseline_env() {
  local selected="$1"
  local main="$2"
  local destination="$3"
  local source=""
  local candidate

  for candidate in \
    "$selected/.env" \
    "$selected/.env.local" \
    "$selected/.env.example" \
    "$main/.env" \
    "$main/.env.local" \
    "$main/.env.example"; do
    if [[ -f "$candidate" ]]; then
      source="$candidate"
      break
    fi
  done

  if [[ -z "$source" ]]; then
    case "$(basename -- "$destination")" in
      frontend.env|cms.env)
        : >"$destination"
        chmod 600 "$destination"
        return 0
        ;;
      *)
        fail "Missing environment baseline: $main/.env"
        ;;
    esac
  fi

  cp "$source" "$destination"
  chmod 600 "$destination"
}

prepare_api_credentials() {
  local env_file="$1"
  local selected="$2"
  local main="$3"
  local credentials_path source destination

  credentials_path="$(env_value "$env_file" GA_CREDENTIALS_PATH)"
  [[ -n "$credentials_path" ]] || return 0

  if [[ "$credentials_path" = /* ]]; then
    [[ -f "$credentials_path" ]] && return 0
    set_env_value "$env_file" GA_CREDENTIALS_PATH ""
    set_env_value "$env_file" GA_PROPERTY_ID ""
    return 0
  fi

  destination="$selected/$credentials_path"
  [[ -f "$destination" ]] && return 0

  source="$main/$credentials_path"
  if [[ -f "$source" ]]; then
    cp "$source" "$destination"
    chmod 600 "$destination"
    return 0
  fi

  # Traffic analytics is optional for local review; missing credentials must
  # not crash the API process.
  set_env_value "$env_file" GA_CREDENTIALS_PATH ""
  set_env_value "$env_file" GA_PROPERTY_ID ""
}

ensure_dependencies() {
  local path="$1"
  if [[ ! -d "$path/node_modules" ]]; then
    printf 'Installing dependencies in %s...\n' "$path"
    (cd "$path" && npm ci)
  fi
}

pick_port() {
  local minimum="$1"
  local maximum="$2"
  local port

  for _ in $(seq 1 100); do
    port="$(shuf -i "$minimum-$maximum" -n 1)"
    if ! ss -H -ltn | awk '{ address=$4; sub(/^.*:/, "", address); print address }' | grep -Fxq "$port"; then
      printf '%s\n' "$port"
      return 0
    fi
  done
  fail "Could not allocate a free port between $minimum and $maximum."
}

env_value() {
  local file="$1"
  local key="$2"
  local line=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$key="* ]] || continue
    printf '%s' "${line#*=}"
  done <"$file"
}

set_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  local temp

  temp="$(mktemp)"
  awk -v key="$key" '$0 !~ "^" key "=" { print }' "$file" >"$temp"
  printf '%s=%s\n' "$key" "$value" >>"$temp"
  mv "$temp" "$file"
  chmod 600 "$file"
}

app_command() {
  case "$1" in
    api) printf '%s\n' './node_modules/.bin/nodemon ./index.js' ;;
    web) printf '%s\n' 'npm run dev -- --port 3000' ;;
    cms) printf '%s\n' 'npm run dev -- --port 3002' ;;
  esac
}

compose_for() {
  local state_dir="$1"
  shift
  docker compose \
    --project-name "dingsglobal-${STACK_ID}" \
    --file "$COMPOSE_FILE" \
    --env-file "$state_dir/compose.env" \
    "$@"
}

wait_for_tunnel() {
  local state_dir="$1"
  local service="$2"
  local logs=""
  local url=""

  for _ in $(seq 1 60); do
    logs="$(compose_for "$state_dir" logs --no-color "$service" 2>&1 || true)"
    url="$(printf '%s\n' "$logs" | grep -Eo 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -n 1 || true)"
    if [[ -n "$url" && "$logs" == *'Registered tunnel connection'* ]]; then
      printf '%s\n' "$url"
      return 0
    fi
    sleep 1
  done

  compose_for "$state_dir" logs --no-color "$service" >&2 || true
  fail "Timed out waiting for $service to create a Quick Tunnel."
}

wait_for_url() {
  local url="$1"
  local origin="${2:-}"
  local args=(--fail --silent --show-error --location --retry 45 --retry-delay 2 --retry-all-errors)
  [[ -n "$origin" ]] && args+=(--header "Origin: $origin")
  curl "${args[@]}" "$url" >/dev/null
}

write_compose_env() {
  local state_dir="$1"
  cat >"$state_dir/compose.env" <<EOF
HOST_UID=$(id -u)
HOST_GID=$(id -g)
BE_COMMAND=$BE_COMMAND
FE_COMMAND=$FE_COMMAND
CMS_COMMAND=$CMS_COMMAND
BE_PATH=$BE_PATH
FE_PATH=$FE_PATH
CMS_PATH=$CMS_PATH
BE_ENV=$state_dir/backend.env
FE_ENV=$state_dir/frontend.env
CMS_ENV=$state_dir/cms.env
BE_PORT=$BE_PORT
FE_PORT=$FE_PORT
CMS_PORT=$CMS_PORT
FE_GATEWAY_PORT=$FE_GATEWAY_PORT
CMS_GATEWAY_PORT=$CMS_GATEWAY_PORT
FE_GATEWAY_CONFIG=$SCRIPT_DIR/nginx/frontend.conf
CMS_GATEWAY_CONFIG=$SCRIPT_DIR/nginx/cms.conf
EOF
  chmod 600 "$state_dir/compose.env"
}

show_stack() {
  local state_dir="$1"
  [[ -f "$state_dir/summary.env" ]] || fail "Unknown stack: $(basename "$state_dir")"
  awk -F= '{ printf "%-18s %s\n", $1 ":", substr($0, index($0, "=") + 1) }' "$state_dir/summary.env"
}

service_state() {
  local services="$1"
  local wanted="$2"
  local service state health

  while IFS='|' read -r service state health; do
    [[ "$service" == "$wanted" ]] || continue
    if [[ "$state" != running ]]; then
      printf '%s\n' "${state:-stopped}"
    elif [[ -n "$health" && "$health" != healthy ]]; then
      printf '%s\n' "$health"
    elif [[ "$health" == healthy ]]; then
      printf 'healthy\n'
    else
      printf 'running\n'
    fi
    return 0
  done <<<"$services"
  printf 'stopped\n'
}

endpoint_is_reachable() {
  curl --fail --silent --show-error --location --connect-timeout 2 --max-time 5 "$1" >/dev/null 2>&1
}

show_stack_status() {
  local state_dir="$1"
  local services backend_status frontend_status="" cms_status=""
  local backend_url frontend_url cms_url overall_status any_active=false

  [[ -f "$state_dir/summary.env" && -f "$state_dir/compose.env" ]] || fail "Unknown stack: $(basename "$state_dir")"
  STACK_ID="$(basename -- "$state_dir")"
  backend_url="$(env_value "$state_dir/summary.env" BACKEND_LOCAL)"
  frontend_url="$(env_value "$state_dir/summary.env" FRONTEND_URL)"
  cms_url="$(env_value "$state_dir/summary.env" CMS_URL)"

  if ! services="$(compose_for "$state_dir" --profile fe --profile cms ps --all --format '{{.Service}}|{{.State}}|{{.Health}}' 2>/dev/null)"; then
    show_stack "$state_dir"
    printf '%-18s %s\n' STATUS UNKNOWN
    printf '%-18s %s\n' COMPOSE_STATUS unavailable
    return 0
  fi

  backend_status="$(service_state "$services" backend)"
  [[ "$backend_status" == healthy || "$backend_status" == running ]] && endpoint_is_reachable "$backend_url/api/v1/health" && backend_status=healthy
  if [[ -n "$frontend_url" ]]; then
    frontend_status="$(service_state "$services" frontend)"
    [[ "$frontend_status" == healthy || "$frontend_status" == running ]] && endpoint_is_reachable "$frontend_url" && frontend_status=healthy
  fi
  if [[ -n "$cms_url" ]]; then
    cms_status="$(service_state "$services" cms)"
    [[ "$cms_status" == healthy || "$cms_status" == running ]] && endpoint_is_reachable "$cms_url" && cms_status=healthy
  fi

  for status in "$backend_status" "$frontend_status" "$cms_status"; do
    [[ -n "$status" && "$status" != stopped ]] && any_active=true
  done
  overall_status=UP
  if [[ "$any_active" == false ]]; then
    overall_status=DOWN
  elif [[ "$backend_status" != healthy || ( -n "$frontend_status" && "$frontend_status" != healthy ) || ( -n "$cms_status" && "$cms_status" != healthy ) ]]; then
    overall_status=DEGRADED
  fi

  show_stack "$state_dir"
  printf '%-18s %s\n' STATUS "$overall_status"
  printf '%-18s %s\n' BACKEND_STATUS "$backend_status"
  [[ -n "$frontend_status" ]] && printf '%-18s %s\n' FRONTEND_STATUS "$frontend_status"
  [[ -n "$cms_status" ]] && printf '%-18s %s\n' CMS_STATUS "$cms_status"
}

stop_stack() {
  local state_dir="$1"
  STACK_ID="$(basename -- "$state_dir")"
  compose_for "$state_dir" --profile fe --profile cms down --volumes --remove-orphans
  printf 'Stopped stack %s. Its isolated database remains available.\n' "$STACK_ID"
}

stack_uses_path() {
  local state_dir="$1"
  local target="$2"
  local metadata_file="$state_dir/summary.env"
  local key

  [[ -f "$metadata_file" ]] || metadata_file="$state_dir/compose.env"
  for key in BACKEND_PATH FRONTEND_PATH CMS_PATH BE_PATH FE_PATH CMS_PATH; do
    [[ "$(env_value "$metadata_file" "$key")" == "$target" ]] && return 0
  done
  return 1
}

cleanup_worktree() {
  [[ $# -eq 2 && "$1" == --path ]] || fail 'cleanup requires --path WORKTREE_PATH.'
  local target="$(canonical_dir "$2")"
  local state_dir found=false
  [[ -d "$RUNTIME_ROOT" ]] || return 0
  for state_dir in "$RUNTIME_ROOT"/*; do
    [[ -f "$state_dir/compose.env" ]] || continue
    stack_uses_path "$state_dir" "$target" || continue
    found=true
    stop_stack "$state_dir"
    rm -rf -- "$state_dir"
    printf 'Removed runtime state for stack %s.\n' "$(basename -- "$state_dir")"
  done
  [[ "$found" == true ]] || printf 'No local application stack uses %s.\n' "$target"
}

up_stack() {
  local custom_name="" explicit_selection=false include_fe=false include_cms=false
  local current_root="" current_repo="" common_dir="" selected_branch="" match=""
  local stack_seed stack_hash stack_label state_dir database_url original_origins allowed_origins
  local frontend_url="" cms_url="" profiles=() app_services=(backend)
  local BE_COMMAND FE_COMMAND CMS_COMMAND

  BE_PATH=""; FE_PATH=""; CMS_PATH=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --web|--fe) [[ $# -ge 2 ]] || fail "$1 requires a path"; FE_PATH="$(canonical_dir "$2")"; include_fe=true; explicit_selection=true; shift 2 ;;
      --api|--be) [[ $# -ge 2 ]] || fail "$1 requires a path"; BE_PATH="$(canonical_dir "$2")"; explicit_selection=true; shift 2 ;;
      --cms) [[ $# -ge 2 ]] || fail '--cms requires a path'; CMS_PATH="$(canonical_dir "$2")"; include_cms=true; explicit_selection=true; shift 2 ;;
      --all) FE_PATH="$WEB_MAIN"; BE_PATH="$API_STAGING"; CMS_PATH="$CMS_MAIN"; include_fe=true; include_cms=true; explicit_selection=true; shift ;;
      --name) [[ $# -ge 2 ]] || fail '--name requires a value'; custom_name="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      *) fail "Unknown option: $1" ;;
    esac
  done

  if [[ "$explicit_selection" == false ]]; then
    current_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$current_root" ]]; then
      common_dir="$(git -C "$current_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
      current_repo="$(basename -- "$(dirname -- "$common_dir")")"
      case "$current_repo" in
        dingsglobal-web) FE_PATH="$current_root"; include_fe=true ;;
        dingsglobal-api) BE_PATH="$current_root" ;;
        dingsglobal-cms) CMS_PATH="$current_root"; include_cms=true ;;
      esac
    fi
  fi
  if [[ -z "$FE_PATH" && -z "$CMS_PATH" && -z "$BE_PATH" ]]; then
    FE_PATH="$WEB_MAIN"; BE_PATH="$API_STAGING"; CMS_PATH="$CMS_MAIN"; include_fe=true; include_cms=true
  fi
  if [[ -z "$BE_PATH" ]]; then
    selected_branch="$(branch_name "${FE_PATH:-$CMS_PATH}")"
    match="$(matching_worktree "$API_STAGING" "$selected_branch" || true)"
    BE_PATH="${match:-$API_STAGING}"
  fi
  if [[ "$include_fe" == false && "$include_cms" == false ]]; then
    selected_branch="$(branch_name "$BE_PATH")"
    match="$(matching_worktree "$WEB_MAIN" "$selected_branch" || true)"
    FE_PATH="${match:-$WEB_MAIN}"
    include_fe=true
  fi

  FE_PATH="${FE_PATH:-$WEB_MAIN}"; CMS_PATH="${CMS_PATH:-$CMS_MAIN}"
  BE_PATH="$(canonical_dir "$BE_PATH")"; FE_PATH="$(canonical_dir "$FE_PATH")"; CMS_PATH="$(canonical_dir "$CMS_PATH")"
  [[ -f "$BE_PATH/package.json" && -f "$BE_PATH/prisma/schema.prisma" ]] || fail "Invalid API checkout: $BE_PATH"
  [[ "$include_fe" == true && -f "$FE_PATH/package.json" ]] || [[ "$include_fe" == false ]] || fail "Invalid web checkout: $FE_PATH"
  [[ "$include_cms" == true && -f "$CMS_PATH/package.json" ]] || [[ "$include_cms" == false ]] || fail "Invalid CMS checkout: $CMS_PATH"

  BE_COMMAND="$(app_command api)"; FE_COMMAND="$(app_command web)"; CMS_COMMAND="$(app_command cms)"
  ensure_dependencies "$BE_PATH"
  if [[ ! -f "$BE_PATH/.env" ]]; then (cd "$BE_PATH" && "$SCRIPT_DIR/dingsglobal-db" setup); fi
  (cd "$BE_PATH" && "$SCRIPT_DIR/dingsglobal-db" ensure)
  ensure_dependencies "$FE_PATH"
  [[ "$include_cms" == true ]] && ensure_dependencies "$CMS_PATH"
  [[ -d "$BE_PATH/generated/prisma" ]] || (cd "$BE_PATH" && npm exec -- prisma generate)

  stack_seed="$BE_PATH|$include_fe:$FE_PATH|$include_cms:$CMS_PATH"
  stack_hash="$(printf '%s' "$stack_seed" | sha256sum | cut -c1-10)"
  stack_label="${custom_name:-$(branch_name "$BE_PATH")-${stack_hash}}"
  stack_label="$(printf '%s' "$stack_label" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c1-40)"
  [[ -n "$stack_label" ]] || stack_label="stack-$stack_hash"
  STACK_ID="${stack_label}-${stack_hash}"; state_dir="$RUNTIME_ROOT/$STACK_ID"
  mkdir -p "$state_dir"; chmod 700 "$RUNTIME_ROOT" "$state_dir"

  if [[ -f "$state_dir/compose.env" ]]; then
    BE_PORT="$(env_value "$state_dir/compose.env" BE_PORT)"; FE_PORT="$(env_value "$state_dir/compose.env" FE_PORT)"; CMS_PORT="$(env_value "$state_dir/compose.env" CMS_PORT)"; FE_GATEWAY_PORT="$(env_value "$state_dir/compose.env" FE_GATEWAY_PORT)"; CMS_GATEWAY_PORT="$(env_value "$state_dir/compose.env" CMS_GATEWAY_PORT)"
  else
    BE_PORT="$(pick_port 31000 31999)"; FE_PORT="$(pick_port 32000 32999)"; CMS_PORT="$(pick_port 33000 33999)"; FE_GATEWAY_PORT="$(pick_port 34000 34999)"; CMS_GATEWAY_PORT="$(pick_port 35000 35999)"
  fi

  copy_baseline_env "$BE_PATH" "$API_STAGING" "$state_dir/backend.env"
  copy_baseline_env "$FE_PATH" "$WEB_MAIN" "$state_dir/frontend.env"
  copy_baseline_env "$CMS_PATH" "$CMS_MAIN" "$state_dir/cms.env"
  prepare_api_credentials "$state_dir/backend.env" "$BE_PATH" "$API_STAGING"
  database_url="$(cd "$BE_PATH" && "$SCRIPT_DIR/dingsglobal-db" url)"
  database_url="${database_url/@127.0.0.1:5432/@postgres:5432}"; database_url="${database_url/@localhost:5432/@postgres:5432}"
  set_env_value "$state_dir/backend.env" DATABASE_URL "$database_url"; set_env_value "$state_dir/backend.env" PORT 3001; set_env_value "$state_dir/backend.env" NODE_ENV development; set_env_value "$state_dir/backend.env" CLOUDFLARE_TURNSTILE_SECRET_KEY "$TEST_TURNSTILE_SECRET_KEY"
  write_compose_env "$state_dir"

  if [[ "$include_fe" == true ]]; then profiles+=(--profile fe); app_services+=(frontend); compose_for "$state_dir" --profile fe up -d --force-recreate gateway-fe; compose_for "$state_dir" --profile fe up -d --force-recreate tunnel-fe; frontend_url="$(wait_for_tunnel "$state_dir" tunnel-fe)"; set_env_value "$state_dir/frontend.env" NEXT_PUBLIC_API_URL "/api/v1"; set_env_value "$state_dir/frontend.env" NEXT_PUBLIC_SITE_URL "$frontend_url"; set_env_value "$state_dir/frontend.env" NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY "$TEST_TURNSTILE_SITE_KEY"; fi
  if [[ "$include_cms" == true ]]; then profiles+=(--profile cms); app_services+=(cms); compose_for "$state_dir" --profile cms up -d --force-recreate gateway-cms; compose_for "$state_dir" --profile cms up -d --force-recreate tunnel-cms; cms_url="$(wait_for_tunnel "$state_dir" tunnel-cms)"; set_env_value "$state_dir/cms.env" NEXT_PUBLIC_API_BASE_URL "/api/v1"; set_env_value "$state_dir/cms.env" NEXT_PUBLIC_ENV development; fi

  original_origins="$(env_value "$state_dir/backend.env" ALLOWED_ORIGINS)"; original_origins="${original_origins%\"}"; original_origins="${original_origins#\"}"; allowed_origins="$original_origins"
  for origin in "$frontend_url" "$cms_url"; do
    [[ -n "$origin" ]] || continue
    [[ ",$allowed_origins," == *",$origin,"* ]] || allowed_origins="${allowed_origins:+$allowed_origins,}$origin"
  done
  if [[ "$include_fe" == true ]]; then
    for origin in "http://localhost:$FE_GATEWAY_PORT" "http://127.0.0.1:$FE_GATEWAY_PORT"; do
      [[ ",$allowed_origins," == *",$origin,"* ]] || allowed_origins="${allowed_origins:+$allowed_origins,}$origin"
    done
  fi
  if [[ "$include_cms" == true ]]; then
    for origin in "http://localhost:$CMS_GATEWAY_PORT" "http://127.0.0.1:$CMS_GATEWAY_PORT"; do
      [[ ",$allowed_origins," == *",$origin,"* ]] || allowed_origins="${allowed_origins:+$allowed_origins,}$origin"
    done
  fi
  set_env_value "$state_dir/backend.env" ALLOWED_ORIGINS "$allowed_origins"; [[ -n "$frontend_url" ]] && set_env_value "$state_dir/backend.env" FRONTEND_URL "$frontend_url"
  compose_for "$state_dir" "${profiles[@]}" up -d --force-recreate --wait "${app_services[@]}"
  [[ -n "$frontend_url" ]] && wait_for_url "$frontend_url/api/v1/health" "$frontend_url" && wait_for_url "$frontend_url"
  [[ -n "$cms_url" ]] && wait_for_url "$cms_url/api/v1/health" "$cms_url" && wait_for_url "$cms_url"

  cat >"$state_dir/summary.env" <<EOF
STACK_ID=$STACK_ID
BACKEND_PATH=$BE_PATH
BACKEND_LOCAL=http://localhost:$BE_PORT
FRONTEND_PATH=$([[ "$include_fe" == true ]] && printf '%s' "$FE_PATH")
FRONTEND_URL=$frontend_url
CMS_PATH=$([[ "$include_cms" == true ]] && printf '%s' "$CMS_PATH")
CMS_URL=$cms_url
EOF
  chmod 600 "$state_dir/summary.env"
  printf '\nDingsGlobal localhost stack is ready.\n'; show_stack "$state_dir"; printf 'Quick Tunnel URLs are public, temporary, and intended only for development.\n'
}

command="${1:-up}"
[[ $# -eq 0 ]] || shift
case "$command" in
  up) up_stack "$@" ;;
  status)
    if [[ $# -gt 0 ]]; then show_stack_status "$RUNTIME_ROOT/$1"; else [[ -d "$RUNTIME_ROOT" ]] || exit 0; for state_dir in "$RUNTIME_ROOT"/*; do [[ -f "$state_dir/summary.env" ]] || continue; show_stack_status "$state_dir"; printf '\n'; done; fi
    ;;
  logs) [[ $# -ge 1 ]] || fail 'logs requires STACK_ID.'; STACK_ID="$1"; state_dir="$RUNTIME_ROOT/$STACK_ID"; [[ -f "$state_dir/compose.env" ]] || fail "Unknown stack: $STACK_ID"; shift; compose_for "$state_dir" logs --no-color "$@" ;;
  down)
    [[ $# -eq 1 ]] || fail 'down requires STACK_ID.'
    if [[ "$1" == -all ]]; then [[ -d "$RUNTIME_ROOT" ]] && for state_dir in "$RUNTIME_ROOT"/*; do [[ -f "$state_dir/compose.env" ]] || continue; stop_stack "$state_dir"; done; else STACK_ID="$1"; state_dir="$RUNTIME_ROOT/$STACK_ID"; [[ -f "$state_dir/compose.env" ]] || fail "Unknown stack: $STACK_ID"; stop_stack "$state_dir"; fi
    ;;
  cleanup) cleanup_worktree "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; fail "Unknown command: $command" ;;
esac
